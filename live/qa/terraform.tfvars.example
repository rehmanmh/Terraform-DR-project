environment = "qa"
aws_region = "ap-northeast-1"
name = "example-qa"
vpc_cidr = "10.20.0.0/16"
azs = ["ap-northeast-1a", "ap-northeast-1c"]
public_cidrs = ["10.20.0.0/24", "10.20.1.0/24"]
private_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]
db_cidrs = ["10.20.20.0/24", "10.20.21.0/24"]
# REPLACE with approved client IP ranges, not 0.0.0.0/0 for administrative services.
allowed_ingress_cidrs = ["203.0.113.0/24"]
deploy_application = true
# Required for active deployments. Use an actual AMI in this Region.
ami_id = "REPLACE_WITH_REGION_AMI"
# Required for active deployments: ACM certificate in the same Region as the ALB.
certificate_arn = "REPLACE_WITH_ACM_CERTIFICATE_ARN"
instance_type = "t3.medium"
min_size = 2
max_size = 6
desired_capacity = 2
db_instance_class = "db.t3.micro"
db_multi_az = false
backup_retention_days = 7
